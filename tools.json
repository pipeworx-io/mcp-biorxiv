[
  {
    "name": "details",
    "description": "DEPRECATED ALIAS for biorxiv_details — identical behavior, kept for existing callers. New callers should use biorxiv_details.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "description": "biorxiv | medrxiv"
        },
        "doi": {
          "type": "string",
          "description": "e.g. \"10.1101/2024.01.15.575982\" (mutually exclusive with date)"
        },
        "date_or_range": {
          "type": "string",
          "description": "YYYY-MM-DD or YYYY-MM-DD/YYYY-MM-DD"
        },
        "cursor": {
          "type": "number",
          "description": "Pagination offset (default 0)."
        }
      },
      "required": [
        "server"
      ]
    }
  },
